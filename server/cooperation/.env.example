# 合作表单后端环境配置示例
# 复制为 .env 后按需修改

# 服务
PORT=8000
# 允许跨域来源，逗号分隔；留空表示同源不限（推荐 Nginx 反代时留空）
# 开发时可设为 * 或 http://localhost:8090,http://localhost:3000
ALLOWED_ORIGINS=
# 限流：同 IP 多少秒内仅允许 1 次提交
RATE_LIMIT_SECONDS=60

# 邮件通知（SMTP）
SMTP_HOST=smtp.example.com
SMTP_PORT=465
# smtp_user/smtp_pass 为空时不发送邮件，仅落库并记录日志
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@wanchunsmart.com
# 接收方，多个用逗号分隔
RECEIVER_EMAIL=contact@wanchunsmart.com
# 是否使用 SSL（465 为 true，587 为 false 自动 STARTTLS）
SMTP_USE_SSL=true

# 查询接口鉴权（GET /api/cooperations 需携带 X-API-KEY 或 Authorization: Bearer <key>）
API_KEY=change-me-please

# 数据存储
# SQLite 路径（相对 server/cooperation/）
DB_PATH=cooperations.db
# JSONL 日志路径
LOG_PATH=cooperations.log
